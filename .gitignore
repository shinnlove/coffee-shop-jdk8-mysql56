# Java / Maven build output
target/
dist/
*.class
*.jar
*.war
*.ear
*.nar

# Logs, archives and crash reports
*.log
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# Local-only files and IDE configuration
.local/
.idea/
*.iml
.env
.env.*
!.env.example
.DS_Store
__MACOSX/
*.ctxt
.mtj.tmp/

# Keep empty mount-point directories; never track database files or transient results.
docker/data/**
!docker/data/.gitkeep
!docker/data/mysql/
!docker/data/mysql/.gitkeep
!docker/data/mysql-test/
!docker/data/mysql-test/.gitkeep
docker/results/**
!docker/results/.gitkeep
