<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.coffee.persistence.dao.InventoryChangeLogDao">
  <resultMap id="inventoryChangeLogResultMap" type="InventoryChangeLogDO" autoMapping="false">
    <id column="id" property="id"/>
    <result column="order_id" property="orderId"/>
    <result column="item_id" property="itemId"/>
    <result column="quantity" property="quantity"/>
    <result column="create_time" property="createTime" typeHandler="com.example.coffee.persistence.typehandler.UtcInstantTypeHandler"/>
    <result column="update_time" property="updateTime" typeHandler="com.example.coffee.persistence.typehandler.UtcInstantTypeHandler"/>
  </resultMap>

<insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
    INSERT INTO inventory_change_log (order_id, item_id, quantity)
    VALUES (#{orderId}, #{itemId}, #{quantity})
  </insert>
</mapper>
