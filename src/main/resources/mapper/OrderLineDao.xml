<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.coffee.persistence.dao.OrderLineDao">
  <resultMap id="orderLineResultMap" type="OrderLineDO" autoMapping="false">
    <id column="id" property="id"/>
    <result column="order_id" property="orderId"/>
    <result column="item_id" property="itemId"/>
    <result column="name" property="name"/>
    <result column="unit_price_minor" property="unitPriceMinor"/>
    <result column="quantity" property="quantity"/>
    <result column="line_total_minor" property="lineTotalMinor"/>
    <result column="create_time" property="createTime" typeHandler="com.example.coffee.persistence.typehandler.UtcInstantTypeHandler"/>
    <result column="update_time" property="updateTime" typeHandler="com.example.coffee.persistence.typehandler.UtcInstantTypeHandler"/>
    <result column="item_code" property="itemCode"/>
  </resultMap>

<insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
    INSERT INTO order_line (order_id, item_id, name, unit_price_minor, quantity, line_total_minor)
    VALUES (#{orderId}, #{itemId}, #{name}, #{unitPriceMinor}, #{quantity}, #{lineTotalMinor})
  </insert>
  <!-- 价格/名称只读快照；关联商品仅取得公开编码，不能按 active 过滤历史订单。 -->
  <select id="findByOrderId" resultMap="orderLineResultMap">
    SELECT ol.id, ol.order_id, ol.item_id, ol.name, ol.unit_price_minor, ol.quantity,
           ol.line_total_minor, ol.create_time, ol.update_time, mi.item_code
    FROM order_line ol LEFT JOIN menu_item mi ON mi.id = ol.item_id
    WHERE ol.order_id = #{orderId} ORDER BY mi.item_code
  </select>
</mapper>
