<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.coffee.persistence.dao.CategoryDao">
  <resultMap id="categoryResultMap" type="CategoryDO" autoMapping="false">
    <id column="id" property="id"/>
    <result column="category_code" property="categoryCode"/>
    <result column="name" property="name"/>
    <result column="create_time" property="createTime" typeHandler="com.example.coffee.persistence.typehandler.UtcInstantTypeHandler"/>
    <result column="update_time" property="updateTime" typeHandler="com.example.coffee.persistence.typehandler.UtcInstantTypeHandler"/>
  </resultMap>

<select id="findAll" resultMap="categoryResultMap">
    SELECT id, category_code, name, create_time, update_time FROM category ORDER BY category_code
  </select>
</mapper>
