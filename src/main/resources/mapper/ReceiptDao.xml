<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.coffee.persistence.dao.ReceiptDao">
  <resultMap id="receiptResultMap" type="ReceiptDO" autoMapping="false">
    <id column="id" property="id"/>
    <result column="order_id" property="orderId"/>
    <result column="payload" property="payload"/>
    <result column="create_time" property="createTime" typeHandler="com.example.coffee.persistence.typehandler.UtcInstantTypeHandler"/>
    <result column="update_time" property="updateTime" typeHandler="com.example.coffee.persistence.typehandler.UtcInstantTypeHandler"/>
  </resultMap>

<insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
    INSERT INTO receipt (order_id, payload) VALUES (#{orderId}, #{payload})
  </insert>
  <select id="findByOrderId" resultMap="receiptResultMap">
    SELECT id, order_id, payload, create_time, update_time FROM receipt WHERE order_id = #{orderId}
  </select>
</mapper>
