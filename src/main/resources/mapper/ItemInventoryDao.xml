<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.coffee.persistence.dao.ItemInventoryDao">
  <resultMap id="itemInventoryResultMap" type="ItemInventoryDO" autoMapping="false">
    <id column="id" property="id"/>
    <result column="item_id" property="itemId"/>
    <result column="stock_quantity" property="stockQuantity"/>
    <result column="create_time" property="createTime" typeHandler="com.example.coffee.persistence.typehandler.UtcInstantTypeHandler"/>
    <result column="update_time" property="updateTime" typeHandler="com.example.coffee.persistence.typehandler.UtcInstantTypeHandler"/>
  </resultMap>

<sql id="itemInventoryColumns">id, item_id, stock_quantity, create_time, update_time</sql>
  <select id="findAll" resultMap="itemInventoryResultMap">
    SELECT <include refid="itemInventoryColumns"/> FROM item_inventory ORDER BY item_id
  </select>
  <!-- 唯一 item_id 定位行；调用方必须已经加入外层可写事务。 -->
  <select id="selectByItemIdForUpdate" resultMap="itemInventoryResultMap" useCache="false" flushCache="true">
    SELECT <include refid="itemInventoryColumns"/> FROM item_inventory WHERE item_id = #{itemId} FOR UPDATE
  </select>
  <update id="deductStock">
    UPDATE item_inventory SET stock_quantity = stock_quantity - #{quantity}
    WHERE item_id = #{itemId} AND stock_quantity >= #{quantity}
  </update>
</mapper>
