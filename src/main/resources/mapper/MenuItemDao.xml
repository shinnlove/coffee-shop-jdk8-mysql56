<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.coffee.persistence.dao.MenuItemDao">
  <resultMap id="menuItemResultMap" type="MenuItemDO" autoMapping="false">
    <id column="id" property="id"/>
    <result column="item_code" property="itemCode"/>
    <result column="category_id" property="categoryId"/>
    <result column="name" property="name"/>
    <result column="price_minor" property="priceMinor"/>
    <result column="active" property="active" javaType="java.lang.Boolean" jdbcType="TINYINT"/>
    <result column="create_time" property="createTime" typeHandler="com.example.coffee.persistence.typehandler.UtcInstantTypeHandler"/>
    <result column="update_time" property="updateTime" typeHandler="com.example.coffee.persistence.typehandler.UtcInstantTypeHandler"/>
  </resultMap>

<select id="findAll" resultMap="menuItemResultMap">
    SELECT id, item_code, category_id, name, price_minor, active, create_time, update_time FROM menu_item ORDER BY item_code
  </select>
</mapper>
